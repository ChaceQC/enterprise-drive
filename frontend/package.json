{
  "name": "enterprise-drive-frontend",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "api:export": "uv run --project ../backend python scripts/export_openapi.py",
    "api:generate": "npm run api:export && node scripts/generate-api.mjs",
    "api:archive:check": "npm run api:export -- --check",
    "api:client:check": "node scripts/generate-api.mjs --check",
    "api:check": "npm run api:archive:check && npm run api:client:check",
    "api:breaking": "python -X utf8 scripts/check_openapi_breaking.py",
    "test:contract": "python -X utf8 -m unittest scripts/test_check_openapi_breaking.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "29.0.1",
    "openapi-typescript-codegen": "0.31.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
