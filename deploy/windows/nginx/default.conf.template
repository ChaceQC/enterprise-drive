map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

map $host $enterprise_drive_storage_host_allowed {
    default 0;
    ${DRIVE_STORAGE_SERVER_NAME} 1;
    localhost 1;
    127.0.0.1 1;
}

upstream enterprise_drive_api {
    server api:18080;
    keepalive 32;
}

upstream enterprise_drive_minio {
    server minio:9000;
    keepalive 32;
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 8080;
    server_name ${DRIVE_SERVER_NAME};
    server_tokens off;

    client_max_body_size ${DRIVE_API_MAX_BODY_SIZE};

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /grafana/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
    }

    location ~ ^/(?:api/v1(?:/|$)|healthz$|readyz$|metrics$|openapi\.json$|docs(?:/|$)|redoc$) {
        proxy_pass http://enterprise_drive_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_buffering off;
    }

    location ^~ /assets/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_upstream http://web:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_cache off;
    }

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_upstream http://web:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_cache off;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

server {
    listen 8080;
    listen 9000 default_server;
    server_name ${DRIVE_STORAGE_SERVER_NAME};
    server_tokens off;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;

    if ($enterprise_drive_storage_host_allowed = 0) {
        return 444;
    }

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://enterprise_drive_minio;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        chunked_transfer_encoding off;
    }
}
