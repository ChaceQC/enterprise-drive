map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

upstream enterprise_drive_api {
    server api:18080;
    keepalive 32;
}

upstream enterprise_drive_minio {
    server minio:9000;
    keepalive 32;
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:TLS:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 8080;
    server_name ${DRIVE_SERVER_NAME} ${DRIVE_STORAGE_SERVER_NAME};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/privkey.pem;

    location / {
        return 444;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${DRIVE_SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/privkey.pem;

    client_max_body_size ${DRIVE_API_MAX_BODY_SIZE};

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /grafana/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
    }

    location ~ ^/(?:api/v1(?:/|$)|healthz$|readyz$|metrics$|openapi\.json$|docs(?:/|$)|redoc$) {
        proxy_pass http://enterprise_drive_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_buffering off;
    }

    location ^~ /assets/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_upstream http://web:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_cache off;
    }

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_upstream http://web:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        proxy_cache off;
    }

    add_header Strict-Transport-Security "max-age=${DRIVE_TLS_HSTS_MAX_AGE}" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${DRIVE_STORAGE_SERVER_NAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DRIVE_TLS_CERT_NAME}/privkey.pem;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://enterprise_drive_minio;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout ${DRIVE_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${DRIVE_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${DRIVE_PROXY_SEND_TIMEOUT};
        chunked_transfer_encoding off;
    }

    add_header Strict-Transport-Security "max-age=${DRIVE_TLS_HSTS_MAX_AGE}" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
