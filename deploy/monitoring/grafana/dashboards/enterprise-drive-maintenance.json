{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "enterprise-drive-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "maintenance_task_consecutive_failures",
          "legendFormat": "{{task}}"
        }
      ],
      "title": "连续失败次数",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "enterprise-drive-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "正常"
                },
                "1": {
                  "text": "告警"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "max by (task) ({__name__=~\"maintenance_task_(alert_active|stale)\"})",
          "legendFormat": "{{task}}"
        }
      ],
      "title": "维护告警与 Stale",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "enterprise-drive-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (task, metric) (increase(maintenance_task_result_total[1h]))",
          "legendFormat": "{{task}} / {{metric}}"
        }
      ],
      "title": "最近一小时维护结果",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "enterprise-drive-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 4,
      "targets": [
        {
          "expr": "maintenance_task_last_success_timestamp_seconds * 1000",
          "legendFormat": "{{task}}"
        }
      ],
      "title": "最近成功时间",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "enterprise-drive",
    "maintenance"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "企业网盘维护治理",
  "uid": "enterprise-drive-maintenance",
  "version": 1
}
