# Windows 11 + Docker Desktop（Linux containers）部署示例。
# 复制为 .env.windows 后，至少替换所有带 change-me 的值。

COMPOSE_PROJECT_NAME=enterprise-drive-windows
DRIVE_IMAGE_TAG=windows-local

# 构建镜像
PYTHON_IMAGE=python:3.12.10-slim-bookworm
UV_VERSION=0.11.7
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1

# Gateway 是唯一发布宿主端口的服务。
# 局域网或公网访问时将 bind 改为 0.0.0.0，并同步配置 Windows 防火墙和可信域名。
DRIVE_GATEWAY_BIND=127.0.0.1
DRIVE_GATEWAY_PORT=18080
DRIVE_STORAGE_GATEWAY_BIND=127.0.0.1
DRIVE_STORAGE_GATEWAY_PORT=19000
DRIVE_SERVER_NAME=localhost
DRIVE_STORAGE_SERVER_NAME=storage.localhost
DRIVE_API_MAX_BODY_SIZE=16m
DRIVE_PROXY_CONNECT_TIMEOUT=10s
DRIVE_PROXY_READ_TIMEOUT=300s
DRIVE_PROXY_SEND_TIMEOUT=300s

# 应用基础配置
DRIVE_ENVIRONMENT=production
DRIVE_DEBUG=false
DRIVE_LOG_LEVEL=INFO
DRIVE_SECRET_KEY=change-me-use-a-long-random-secret
DRIVE_API_WORKERS=2
DRIVE_FORWARDED_ALLOW_IPS=*

# PostgreSQL
POSTGRES_DB=enterprise_drive
POSTGRES_USER=drive
POSTGRES_PASSWORD=change-me-postgres-password
DRIVE_DATABASE_URL=postgresql+asyncpg://drive:change-me-postgres-password@postgres:5432/enterprise_drive
DRIVE_DATABASE_POOL_MODE=queue
DRIVE_DATABASE_POOL_SIZE=3
DRIVE_DATABASE_MAX_OVERFLOW=2
DRIVE_DATABASE_POOL_TIMEOUT_SECONDS=10

# Redis / Celery
REDIS_PASSWORD=change-me-redis-password
DRIVE_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
DRIVE_CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/1
DRIVE_CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/2
DRIVE_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
DRIVE_MAINTENANCE_TASK_BATCH_SIZE=100
DRIVE_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
DRIVE_BLOB_CLEANUP_INTERVAL_SECONDS=3600
DRIVE_ORPHAN_OBJECT_SCAN_INTERVAL_SECONDS=86400
DRIVE_QUOTA_RECONCILIATION_INTERVAL_SECONDS=86400

# MinIO。内部地址只供容器访问；公共地址由 Gateway 的 19000 端口转发。
MINIO_ROOT_USER=drive
MINIO_ROOT_PASSWORD=change-me-minio-password
DRIVE_S3_ENDPOINT_URL=http://minio:9000
DRIVE_S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
DRIVE_S3_BUCKET=enterprise-drive
DRIVE_S3_REGION=us-east-1
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:15173

# OpenSearch
DRIVE_OPENSEARCH_URL=http://opensearch:9200
DRIVE_OPENSEARCH_INDEX_NAME=drive_files_v1
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Change-Me-OpenSearch-2026!
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# 浏览器安全配置。启用 HTTPS 后将 Secure 改为 true。
DRIVE_CORS_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
DRIVE_TRUSTED_HOSTS=["localhost","127.0.0.1"]
DRIVE_SESSION_COOKIE_SECURE=false
DRIVE_SESSION_COOKIE_SAMESITE=lax

# 初始管理员
DRIVE_ADMIN_TENANT_SLUG=default
DRIVE_ADMIN_TENANT_NAME=默认企业
DRIVE_ADMIN_USERNAME=admin
DRIVE_ADMIN_EMAIL=admin@example.com
DRIVE_ADMIN_PASSWORD=change-me-admin-password

# 预览 Worker
DRIVE_PREVIEW_OFFICE_MAX_PDF_BYTES=52428800
DRIVE_PREVIEW_PDF_DPI=144
DRIVE_PREVIEW_PDF_MAX_RENDERED_BYTES=52428800
DRIVE_PREVIEW_COMMAND_TIMEOUT_SECONDS=30
DRIVE_PREVIEW_TASK_SOFT_TIME_LIMIT_SECONDS=120
DRIVE_PREVIEW_TASK_TIME_LIMIT_SECONDS=150
DRIVE_PREVIEW_TASK_RATE_LIMIT=30/m
PREVIEW_WORKER_CONCURRENCY=1
PREVIEW_WORKER_MAX_TASKS_PER_CHILD=20
PREVIEW_TMPFS_SIZE=1073741824

# 其他 Worker
AUDIT_WORKER_CONCURRENCY=2
PERMISSION_WORKER_CONCURRENCY=2
SEARCH_WORKER_CONCURRENCY=2
MAINTENANCE_WORKER_CONCURRENCY=1

# 日志轮转
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5

# 资源上限，可按 Docker Desktop 分配的 CPU/内存调整。
GATEWAY_CPU_LIMIT=0.50
GATEWAY_MEMORY_LIMIT=256m
API_CPU_LIMIT=2.00
API_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_SHM_SIZE=256m
REDIS_CPU_LIMIT=1.00
REDIS_MEMORY_LIMIT=1g
MINIO_CPU_LIMIT=2.00
MINIO_MEMORY_LIMIT=2g
OPENSEARCH_CPU_LIMIT=2.00
OPENSEARCH_MEMORY_LIMIT=3g
OPENSEARCH_SHM_SIZE=512m
PREVIEW_WORKER_CPU_LIMIT=2.00
PREVIEW_WORKER_MEMORY_LIMIT=3g
